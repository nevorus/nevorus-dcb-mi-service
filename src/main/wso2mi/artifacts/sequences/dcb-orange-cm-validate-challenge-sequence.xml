<?xml version="1.0" encoding="UTF-8"?>
<sequence name="dcb-orange-cm-validate-challenge-sequence" xmlns="http://ws.apache.org/ns/synapse">

    <log category="INFO">
        <property name="msg" value="dcb-orange-cm-validate-challenge-sequence - START"/>
        <property name="challengeId" expression="get-property('uri.var.challengeId')"/>
    </log>

    <property name="country"          expression="json-eval($.challenge.country)"  scope="default"         type="STRING"/>
    <property name="operator"         expression="json-eval($.challenge.operator)" scope="default"         type="STRING"/>
    <property name="inputType0"       expression="json-eval($.challenge.inputs[0].type)" scope="default"   type="STRING"/>
    <property name="inputValue0"      expression="json-eval($.challenge.inputs[0].value)" scope="default"  type="STRING"/>
    <property name="confirmationCode" expression="json-eval($.challenge.inputs[1].value)" scope="default"  type="STRING"/>
    <property name="challengeId"      expression="get-property('uri.var.challengeId')" scope="default" type="STRING"/>

    <sequence key="dcb-country-mapping-sequence"/>
    <sequence key="dcb-orange-generate-token-sequence"/>

    <payloadFactory media-type="json">
        <format>{
            "challenge": {
            "method": "OTP-SMS-AUTH",
            "country": "$1",
            "service": "$2",
            "partnerId": "$3",
            "inputs": [
            {"type": "$4", "value": "$5"},
            {"type": "confirmationCode", "value": "$6"},
            {"type": "info", "value": "ise2"}
            ]
            }
            }</format>
        <args>
            <arg evaluator="xml" expression="$ctx:alpha3Country"/>
            <arg evaluator="xml" expression="$ctx:orangeService"/>
            <arg evaluator="xml" expression="$ctx:orangePartnerId"/>
            <arg evaluator="xml" expression="$ctx:inputType0"/>
            <arg evaluator="xml" expression="$ctx:inputValue0"/>
            <arg evaluator="xml" expression="$ctx:confirmationCode"/>
        </args>
    </payloadFactory>
    <property name="orangeChallengeRelPath" expression="${configs.orange_challenge_rel_path}" scope="default" type="STRING" />
    <property name="orangeFullPath"
              expression="fn:concat($ctx:orangeChallengeRelPath, '/', $ctx:challengeId)"
              scope="default"
              type="STRING"/>
    <log category="INFO">
        <property name="msg" value="dcb-orange-cm-validate-challenge-sequence - Appel Orange validation OTP"/>
        <property name="orangeFullPath" expression="$ctx:orangeFullPath"/>
    </log>
    <log category="INFO">
        <property name="payloadSud" expression="json-eval($)"/>
    </log>

    <http.post configKey="OrangeConnection">
        <relativePath>{$ctx:orangeFullPath}</relativePath>
        <headers>[["Content-Type","application/json"],["Authorization","Bearer $ctx:orangeAccessToken"]]</headers>
        <requestBodyType>JSON</requestBodyType>
        <requestBodyJson>${payload}</requestBodyJson>
        <forceScAccepted>false</forceScAccepted>
        <disableChunking>false</disableChunking>
        <forceHttp10>false</forceHttp10>
        <noKeepAlive>false</noKeepAlive>
        <forcePostPutNobody>false</forcePostPutNobody>
        <forceHttpContentLength>false</forceHttpContentLength>
    </http.post>

    <script language="js"><![CDATA[
    var response = mc.getPayloadJSON();
    if (response.challenge) {
        response.challenge.country = mc.getProperty("country");
    }
    mc.setPayloadJSON(response);
    ]]></script>

    <respond/>

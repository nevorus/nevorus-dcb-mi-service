<?xml version="1.0" encoding="UTF-8"?>
<sequence name="dcb-orange-cm-generate-challenge-sequence" xmlns="http://ws.apache.org/ns/synapse">

    <!-- EXTRACT JSON PROPERLY -->
    <property name="country" expression="json-eval($.challenge.country)" scope="default" type="STRING"/>
    <property name="operator" expression="json-eval($.challenge.operator)" scope="default" type="STRING"/>

    <log category="INFO">
        <property name="START" value="dcb-orange-cm-generate-challenge-sequence"/>
        <property name="country" expression="get-property('country')"/>
        <property name="operator" expression="get-property('operator')"/>
    </log>

    <sequence key="dcb-country-mapping-sequence"/>
    <sequence key="dcb-mock-token-sequence"/>
    <!--<sequence key="dcb-orange-generate-token-sequence"/>-->

    <!-- Construire les inputs -->
    <script language="js"><![CDATA[
    var payload = mc.getPayloadJSON();
    var inputs  = (payload.challenge && payload.challenge.inputs) ? payload.challenge.inputs : [];
    var hasCC   = false;
    for (var i = 0; i < inputs.length; i++) {
        if (inputs[i].type === "confirmationCode") { hasCC = true; break; }
    }
    if (!hasCC) inputs.splice(1, 0, {"type": "confirmationCode", "value": ""});
    mc.setProperty("inputsSud", JSON.stringify(inputs));
    ]]></script>

    <!-- Construire le payload sud -->
    <payloadFactory media-type="json">
        <format>{
            "challenge": {
            "method": "OTP-SMS-AUTH",
            "country": "$1",
            "service": "$2",
            "partnerId": "$3",
            "inputs": $4
            }
            }</format>
        <args>
            <arg evaluator="xml" expression="$ctx:alpha3Country"/>
            <arg evaluator="xml" expression="$ctx:orangeService"/>
            <arg evaluator="xml" expression="$ctx:orangePartnerId"/>
            <arg evaluator="json" expression="$ctx:inputsSud"/>
        </args>
    </payloadFactory>

    <log category="INFO">
        <message>dcb-orange-cm-generate-challenge-sequence - Appel Orange challenge</message>
        <property name="path" expression="${configs.orange_challenge_rel_path}"/>
    </log>
    <log category="INFO">
        <property name="payloadSud" expression="json-eval($)"/>
    </log>

    <http.post configKey="OrangeConnection">
        <relativePath>{${configs.orange_challenge_rel_path}}</relativePath>
        <headers>[["Content-Type","application/json"],["Authorization","Bearer $ctx:orangeAccessToken"]]</headers>
        <requestBodyType>JSON</requestBodyType>
        <requestBodyJson>${payload}</requestBodyJson>
    </http.post>

    <script language="js"><![CDATA[
        var loc = mc.getProperty("locationHeader");
        var id  = (loc && loc !== "null") ? loc.split("/").pop() : "UNKNOWN";
        mc.setVariable("challengeId", id);
    ]]></script>

    <log category="INFO">
        <message>dcb-orange-cm-generate-challenge-sequence - SUCCES, challengeId: $ctx:challengeId</message>
    </log>

    <respond/>

    <!--<property name="httpStatus"     expression="$axis2:HTTP_SC" scope="default"/>

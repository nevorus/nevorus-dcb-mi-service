        <format>{
            "challenge": {
                "country": "$1",
                "operator": "$2",
                "challengeId": "$3",
                }
            }</format>
        <args>
            <arg evaluator="xml" expression="$ctx:country"/>
            <arg evaluator="xml" expression="$ctx:operator"/>
            <arg evaluator="xml" expression="$ctx:challengeId"/>
        </args>
    </payloadFactory>-->


</sequence>

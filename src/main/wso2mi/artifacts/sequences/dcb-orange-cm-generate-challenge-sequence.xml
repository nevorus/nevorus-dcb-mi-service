                <property name="message"
                          expression="fn:concat('dcb-orange-cm-generate-challenge-sequence - ECHEC Orange, HTTP: ', get-property('httpStatus'))"/>
            </log>
            <property name="errorCode" value="CHALLENGE_GENERATE_FAILED" scope="default"/>
            <property name="errorMessage"
                      expression="json-eval($.error.message)"
                      scope="default"/>
            <sequence key="dcb-global-error-handler-sequence"/>
        </then>
    </filter>
        <property name="HTTP_SC" value="201" scope="axis2"/>

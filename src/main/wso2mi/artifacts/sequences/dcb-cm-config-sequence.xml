<?xml version="1.0" encoding="UTF-8"?>
<!-- dcb-cm-config-sequence – Cameroun / Orange -->
<sequence name="dcb-cm-config-sequence" xmlns="http://ws.apache.org/ns/synapse">

    <property name="alpha3Country" value="CMR" scope="default"/>
    <property name="orangeMCO" value="OCM" scope="default"/>
    <property name="orangeService" value="BRASTORNE" scope="default"/>
    <property name="orangePartnerId" value="PDKSUB" scope="default"/>

    <log category="INFO">
        <property name="message" value="dcb-cm-config-sequence - CMR configuré"/>
        <property name="service" expression="$ctx:orangeService"/>
        <property name="mco" expression="$ctx:orangeMCO"/>
    </log>

</sequence>
